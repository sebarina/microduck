<mujoco model="scene_desk">
    <!-- Desk-walking verification scene for duck-sim:
             DUCK_SIM_SCENE=desk DUCK_SIM_KEYFRAME=DESK_STAND scripts/duck-sim
         Same robot as scene_sofa.xml (backlash model) + the ODG
         desk_multiview_a "box" asset, unrotated. Its top is a clean
         0.59 x 1.21 m plate at z = 0.7566 (measured, see desk_constants.py).

         WHY THE DESK IS INLINED INSTEAD OF <include>d: the robot XML sets
         compiler meshdir="assets", and MuJoCo resolves an included file's mesh
         paths against meshdir + the include's own directory, which double-
         prefixes them (assets/.../assets/desk/visual_mv/...). The sofa worked
         around this by writing ABSOLUTE mesh paths in odg_sofa_concept_a_soft.xml
         -- which breaks the moment the repo moves or is shipped in the bundle.
         Inlining keeps this scene free of absolute paths: mesh paths below are
         relative to meshdir="assets", i.e. assets/desk/visual_mv/*.obj.

         Contact is left furniture-HARD (solref 0.02) on purpose -- the desk's
         whole contribution to a mixed training run is a rigid surface. -->
    <include file="robot_groundcontact_backlash.xml" />

    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
        <rgba haze="0.15 0.25 0.35 1" />
        <global azimuth="160" elevation="-20" />
    </visual>

    <asset>
        <mesh name="odg_desk_multiview_a_vis_0" file="desk/visual_mv/vis_0.obj" inertia="shell" />
